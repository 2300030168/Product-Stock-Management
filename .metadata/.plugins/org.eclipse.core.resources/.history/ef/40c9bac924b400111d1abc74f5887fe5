server.port=8080

# ---- Default: H2 file database (no installation needed) ----
spring.datasource.url=jdbc:h2:file:./data/inventorydb;AUTO_SERVER=TRUE
spring.datasource.username=sa
spring.datasource.password=
spring.h2.console.enabled=true

# ---- To use MySQL instead, comment the 3 lines above and uncomment these ----
#spring.datasource.url=jdbc:mysql://localhost:3306/inventory_db?createDatabaseIfNotExist=true
#spring.datasource.username=root
#spring.datasource.password=your_password

spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
